{
  "name": "firetable-grid",
  "version": "0.4.0",
  "description": "Schema-driven filter, sort, group and export engine for TanStack Table — generic over your row type.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carsdatacom/firetable-grid.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "styles",
    "examples",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles/palette.css": "./styles/palette.css",
    "./styles/grid.css": "./styles/grid.css"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check",
    "format": "biome format --write",
    "demo": "bun demo/build.ts",
    "bench": "bun bench/index.ts",
    "prepare": "bun run build"
  },
  "dependencies": {
    "dequal": "^2.0.3"
  },
  "peerDependencies": {
    "@tanstack/react-table": ">=9",
    "@tanstack/react-virtual": "^3",
    "@tanstack/table-core": ">=9",
    "exceljs": "^4.4.0",
    "react": ">=18",
    "react-dom": ">=18",
    "server-only": "^0.0.1",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    },
    "server-only": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@tanstack/react-virtual": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "exceljs": "^4.4.0",
    "mitata": "^1.0.34",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "zod": "^4.6.2"
  },
  "keywords": [
    "tanstack-table",
    "data-grid",
    "table",
    "filter",
    "csv",
    "xlsx"
  ]
}
